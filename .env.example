# Copy this file to .env and edit
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zameen_islamabad

# Seconds to wait between page loads (random between min and max). Keep it 3 or more.
DELAY_MIN=3
DELAY_MAX=5

# Gzipped copies of downloaded pages, in data/raw/<date>/, for debugging.
# RAW_COPIES: failed = only pages that couldn't be used (named FAILED-*), all = every page (~3.5 GB/week
# with all cities), none = no copies. RAW_KEEP_DAYS: delete copies older than this (0 = keep none).
RAW_COPIES=failed
RAW_KEEP_DAYS=2
RAW_DIR=data/raw

# Every-6-hours check for new ads: true = on, false = off. Takes effect right away (no restart needed).
NEW_CHECKS_ENABLED=false

# How often the scheduled new-ad check wakes up, in hours (6 = 4 times a day). It's also the shortest
# interval any city gets. After changing it, run: python main.py schedule install
NEW_CHECK_EVERY_HOURS=6

# Each city is checked at its own pace (busy cities every 6 h, quiet ones less often), set automatically
# from how many new ads it gets. This is the longest any city waits, in hours (24, 48, 72...).
NEW_CHECK_MAX_HOURS=24
